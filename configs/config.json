{
  // ==================================================
  // Data Source Configuration
  // ==================================================
  "data_sources": {
    "enabled": [
      "arxiv",
      "prl",
      "nature",
      "nature_communications",
      "science",
      "science_advances",
      "npj_quantum_information"
    ],
    "extra_sources": {
      "enabled": true,
      "definitions": [
        {
          "type": "openalex_journal",
          "code": "nature",
          "display_name": "Nature",
          "full_name": "Nature",
          "issn": [
            "0028-0836",
            "1476-4687"
          ]
        },
        {
          "type": "openalex_journal",
          "code": "nature_communications",
          "display_name": "Nat. Commun.",
          "full_name": "Nature Communications",
          "issn": [
            "2041-1723"
          ]
        },
        {
          "type": "openalex_journal",
          "code": "science",
          "display_name": "Science",
          "full_name": "Science",
          "issn": [
            "0036-8075",
            "1095-9203"
          ]
        },
        {
          "type": "openalex_journal",
          "code": "science_advances",
          "display_name": "Sci. Adv.",
          "full_name": "Science Advances",
          "issn": [
            "2375-2548"
          ]
        },
        {
          "type": "openalex_journal",
          "code": "npj_quantum_information",
          "display_name": "npj QI",
          "full_name": "npj Quantum Information",
          "issn": [
            "2056-6387"
          ]
        }
      ]
    },
    "reports_by_source": true,
    "arxiv": {
      "fetch_mode": "keywords",
      "keyword_operator": "or",
      "max_results_total": 100,
      "fetch_timeout_seconds": 180,
      "announcement_lookback_grace_days": 2,
      "max_results_per_domain": 100
    },
    "huggingface_papers": {
      "availability_lag_days": 2,
      "lookback_grace_days": 2,
      "request_timeout_seconds": 30,
      "request_interval_seconds": 0.25
    }
  },

  "run_lock": {
    "max_age_hours": 12
  },

  "target_domains": {
    "domains": [
      "cs.CV",
      "cs.LG",
      "quant-ph",
      "eess.IV",
      "q-bio.QM"
    ]
  },

  "keywords": {
    "primary_keywords": {
      "weight": 1.0,
      "keywords": [
        "medical image analysis",
        "medical image segmentation",
        "deep learning medical imaging",
        "AI for diagnosis",
        "prognosis prediction",
        "surgical planning",
        "multimodal medical imaging",
        "foundation models medical imaging"
      ]
    },
    "enable_reference_extraction": true,
    "reference_keywords_config": {
      "max_keywords": 10,
      "similarity_threshold": 0.75,
      "weight_distribution": {
        "high_importance": {
          "weight": 1.0,
          "count": 3
        },
        "medium_importance": {
          "weight": 0.2,
          "count": 5
        },
        "low_importance": {
          "weight": 0.1,
          "count": 2
        }
      }
    },
    "research_context": "Research area: medical image analysis and artificial intelligence for clinical decision support.\nFocus topics include:\n- Medical image segmentation and anatomical structure modeling\n- Deep learning for CT, MRI, and ultrasound imaging\n- AI-based disease diagnosis and prognosis prediction\n- Image-based surgical planning and surgical guidance\n- Multimodal medical data fusion\n- Robust and generalizable AI models for healthcare"
  },

  "scoring_settings": {
    "keyword_relevance_score": {
      "max_score_per_keyword": 10
    },
    "author_bonus": {
      "enabled": false,
      "expert_authors": [],
      "bonus_points": 5.0
    },
    "passing_score_formula": {
      "base_score": 5.0,
      "weight_coefficient": 3.0
    },
    "include_all_in_report": true,
    "strategy": {
      "id": "legacy_weighted_keyword_v1",
      "core_relevance_threshold": 6.0,
      "core_keyword_min_score": 7.0,
      "reference_ranking_weight": 0.25,
      "learned_weight_dampening": 0.5,
      "learned_term_weight_cap": 2.0
    }
  },

  "paths": {
    "data_dir": "data",
    "reference_pdfs": "data/reference_pdfs",
    "reports": "data/reports",
    "downloaded_pdfs": "data/downloaded_pdfs",
    "history_dir": "data/history"
  },

  "keyword_tracker": {
    "enabled": true,
    "database": {
      "path": "data/keywords/keywords.db"
    },
    "normalization": {
      "enabled": true,
      "batch_size": 25
    },
    "trend_view": {
      "default_days": 30
    },
    "charts": {
      "bar_chart": {
        "top_n": 15
      },
      "trend_chart": {
        "top_n": 5
      }
    },
    "report": {
      "enabled": true,
      "frequency": "monthly"
    }
  },

  "notifications": {
    "enabled": true,
    "on_success": true,
    "on_failure": false,
    "attach_reports": true,
    "top_n": 5,
    "channels": {
      "email": {
        "enabled": true
      },
      "wechat_work": {
        "enabled": false
      },
      "dingtalk": {
        "enabled": false
      },
      "telegram": {
        "enabled": false
      },
      "slack": {
        "enabled": false
      },
      "generic_webhook": {
        "enabled": false
      }
    }
  },

  "retry": {
    "max_attempts": 3,
    "min_wait": 2,
    "max_wait": 30
  },

  "logging": {
    "rotation_type": "time",
    "keep_days": 30
  },

  "concurrency": {
    "enabled": false,
    "workers": 2
  },
  "llm_request_pool": {
    "enabled": true,
    "requests_per_minute": 30,
    "log_slow_wait_seconds": 5.0
  },
  "llm": {
    "timeout_seconds": 300.0,
    "sdk_max_retries": 1,
    "retry_max_attempts": 5,
    "retry_min_wait": 5,
    "retry_max_wait": 120
  },
  "daily_research": {
    "enable_deep_analysis": true,
    "scan_window_days": 7,
    "max_papers_per_run": 100,
    "pending_retention_days": 7,
    "run_time": "08:00",
    "db_path": "data/daily_research/daily_research.db"
  },

  "favorites": {
    "auto_favorite_qualified_papers": false
  },

  "history_maintenance": {
    "max_papers_per_run": 3,
    "run_mode": "idle",
    "time_window_start": "00:00",
    "time_window_end": "06:00"
  },

  "legacy_history": {
    "full_repair_enabled": false
  },

  "pdf_parser": {
    "mode": "pymupdf",
    "mineru_model_version": "pipeline",
    "poll_interval": 3,
    "poll_timeout": 300,
    "download_max_bytes": 26214400
  },

  "report_settings": {
    "enable_html_report": true,
    "enable_markdown_report": true
  },

  "auto_update": {
    "enabled": true
  },

  "token_tracking": {
    "enabled": true
  },

  "proxy": {
    "enabled": false,
    "url": "",
    "no_proxy": "localhost,127.0.0.1",
    "scope": {
      "arxiv": true,
      "openalex": false,
      "huggingface_papers": false,
      "semantic_scholar": false,
      "llm_api": false,
      "notifications": false,
      "webdav": true,
      "update_check": false
    }
  },

  "webdav": {
    "enabled": false,
    "remote_path": "/arxiv-daily-researcher/",
    "sync_mode": "after_report",
    "cron_schedule": "0 23 * * *",
    "sync_configs": false,
    "sync_history": false,
    "sync_keywords": false,
    "sync_reports": false
  },

  "backup": {
    "enabled": true,
    "local_retention_days": 7,
    "same_day_max_count": 0
  },

  "trend_research": {
    "default_date_range_days": 31,
    "max_results": 200,
    "sort_order": "ascending",
    "report_position": "end",
    "generate_tldr": true,
    "tldr_batch_size": 10,
    "output_formats": [
      "markdown",
      "html"
    ],
    "enabled_skills": [
      "comprehensive_analysis"
    ],
    "monthly_categories": [
      "cs.CV",
      "cs.LG",
      "eess.IV",
      "q-bio.QM"
    ],
    "monthly_keywords": [
      "medical image analysis",
      "medical image segmentation",
      "deep learning medical imaging",
      "AI for diagnosis",
      "prognosis prediction",
      "surgical planning",
      "multimodal medical imaging",
      "foundation models medical imaging"
    ],
    "analysis_prompt": "你是医学影像与人工智能领域的资深研究分析师。请基于检索到的本月全部论文（标题、作者、日期、分类、摘要与 TLDR），撰写一份结构化的「月度研究回顾」Markdown 报告。\n\n必须包含以下章节（使用二级标题）：\n1. **本月概览**：用 3–5 句话概括本月该主题的整体活跃度与主旋律。\n2. **热点话题与方法**：列出 3–5 个出现频率最高或影响最大的技术方向、模型范式或数据集；说明它们之间的关联。\n3. **时间演变**：按提交时间顺序，指出月内早期与晚期的关注重心是否发生转移（若有）。\n4. **代表工作与突破**：点名 3–5 篇值得精读的代表作（给出 arXiv ID 或标题），说明理由。\n5. **核心研究者与机构**：归纳重复出现的作者或团队（如有）。\n6. **研究空白与未来方向**：基于摘要信息指出尚未充分覆盖的问题、或可跟进的方向。\n7. **与临床/应用的衔接**：若涉及诊断、预后、手术规划等，单独简要评述临床转化信号。\n\n写作要求：\n- 使用中文，语气客观、信息密度高，避免空洞形容词。\n- 不要编造论文中未出现的方法、数值或结论；信息不足处明确写「本批摘要未体现」。\n- 若样本量很少（少于 10 篇），在概览中说明并相应缩短各节。"
  }
}
